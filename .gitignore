# ==============================================================================
# LUMINA - .gitignore
# Clean workspace configuration for GitHub & multi-machine development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECRETS & CREDENTIALS (Never commit to GitHub)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
.gemini-key
*credentials*.json
*oauth*.json
*token*.json
*client_secret*.json
*.dpapi
config/api_keys.json
config/certs/
config/whatsapp_web/

# ------------------------------------------------------------------------------
# 2. LOCAL MACHINE CONFIGURATION & RUNTIME STATE
# ------------------------------------------------------------------------------
# Local machine configuration containing local paths and private keys
lumina.toml
!lumina.example.toml

# Active runtime state and synchronization files
.lumina-control-unresolved.json
.lumina-file-controller/
lumina-automation.json*
lumina-reminders.json*
last-session.json

# Local databases and locks
*.sqlite3*
*.db
*.db-*
*.lock
memory/long_term.json
memory/*.db

# ------------------------------------------------------------------------------
# 3. PERSONAL KNOWLEDGE, PRIVATE NOTES & LOCAL BROWSER PROFILES
# ------------------------------------------------------------------------------
notes/
graphify-out/
Uploads/
LuminaBrowserProfile/

# ------------------------------------------------------------------------------
# 4. PYTHON BUILD NOISE & VIRTUAL ENVIRONMENTS
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/

.venv/
venv/
env/
ENV/
.venv-transferred-*/
pip/

# ------------------------------------------------------------------------------
# 5. .NET / C# COMPILATION OUTPUT
# ------------------------------------------------------------------------------
**/bin/
**/obj/
*.user
*.suo
*.userosscache
*.sln.docstates
desktop/lumina.ico

# ------------------------------------------------------------------------------
# 6. LOGS, ARTIFACTS & SCRATCHPADS
# ------------------------------------------------------------------------------
*.log
logs/
debug.log
debug_dump/
artifacts/
scratch/
downloads/
screenshots/
workspace-panel-check.png
typescript

# ------------------------------------------------------------------------------
# 7. HISTORICAL RECOVERY, ARCHIVES & STANDALONE SITES
# ------------------------------------------------------------------------------
archive/
.recovery/
LUMINA-Recovered/
LUMINA-Recovery-Data/
sources/
*-test-data*/
*-native-data*/
tests/

# ------------------------------------------------------------------------------
# 8. EDITORS & OPERATING SYSTEM JUNK
# ------------------------------------------------------------------------------
.vscode/
.idea/
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 9. EXPLICIT PRESERVATIONS FOR MULTI-MACHINE CLONING (Needed on other PC)
# ------------------------------------------------------------------------------
!.env.example
!lumina.example.toml
!requirements.txt
!requirements-dev.txt
!requirements-phase1.txt
!pytest.ini
!start.ps1
!start-recovered.ps1
!RECOVERY-INTEGRATION.md
!docs/
!docs/**
!benchmarks/
!benchmarks/**